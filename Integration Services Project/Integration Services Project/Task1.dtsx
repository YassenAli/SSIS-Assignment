          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data.SqlClient;
using System.Net;
using System.IO;
using Microsoft.SqlServer.Dts.Runtime;
using System.Text;
using Newtonsoft.Json;       // Make sure you have a reference to Newtonsoft.Json
using Newtonsoft.Json.Linq; // For JObject, JArray
#endregion

namespace ST_YourScriptTaskName
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            // 1. Call the REST API and get the response as a string
            string url = "http://universities.hipolabs.com/search?name=middle";
            string jsonResponse = GetApiResponse(url);

            // 2. Parse the JSON response
            //    Assuming the response is an array of objects, each with "name", "country", "alpha_two_code".
            //    Example item:
            //    {
            //        "name": "Middle Georgia State College",
            //        "country": "United States",
            //        "alpha_two_code": "US",
            //        ...
            //    }

            JArray universityArray = JArray.Parse(jsonResponse);

            // 3. Insert the parsed data into the SQL table
            //    Use an ADO.NET or OLE DB connection. We'll demonstrate ADO.NET with SqlClient.
            //    Make sure you have a valid connection string in the code or use an SSIS variable.

            // This example uses a hard-coded connection string for demonstration.
            // Replace Data Source, Initial Catalog, User ID, Password accordingly.
            string connectionString = "Data Source=YASSIN-ALI\\MSSQLSERVER2022;Initial Catalog=DWHASS;Integrated Security=SSPI;";

            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                conn.Open();

                foreach (var item in universityArray)
                {
                    string name = item["name"]?.ToString() ?? "";
                    string country = item["country"]?.ToString() ?? "";
                    string alphaCode = item["alpha_two_code"]?.ToString() ?? "";

                    // Insert into the University table
                    string insertQuery = @"
                INSERT INTO [dbo].[University] ([name], [country], [alpha_two_code]) 
                VALUES (@name, @country, @alphaCode)";

                    using (SqlCommand cmd = new SqlCommand(insertQuery, conn))
                    {
                        cmd.Parameters.AddWithValue("@name", name);
                        cmd.Parameters.AddWithValue("@country", country);
                        cmd.Parameters.AddWithValue("@alphaCode", alphaCode);

                        cmd.ExecuteNonQuery();
                    }
                }

                conn.Close();
            }

            // 4. Indicate success
            Dts.TaskResult = (int)ScriptResults.Success;
        }

        /// <summary>
        /// Helper method to make a GET request to a specified URL and return response as string.
        /// </summary>
        private string GetApiResponse(string url)
        {
            HttpWebRequest request = (HttpWebRequest)WebRequest.Create(url);
            request.Method = "GET";
            // If the API requires headers, authentication, or tokens, set them here:
            // request.Headers["Authorization"] = "Bearer <token>";

            string responseContent;
            using (HttpWebResponse response = (HttpWebResponse)request.GetResponse())
            {
                using (StreamReader reader = new StreamReader(response.GetResponseStream()))
                {
                    responseContent = reader.ReadToEnd();
                }
            }
            return responseContent;
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        }
    }
}]]></ProjectItem>
