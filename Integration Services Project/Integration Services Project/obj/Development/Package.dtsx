  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A8CAD6FC-89A9-459A-9084-2551A9BE2126}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F477BFB1-AB1E-4714-B28C-09B0A19581DF}"
          SQLTask:SqlStatementSource="/******************************************************&#xA; Step 1: Create a temporary staging table (#SourceTemp)&#xA;         that identifies whether a record for the same ID&#xA;         and Schedule_Date already exists (active) in the target.&#xA;*******************************************************/&#xA;IF OBJECT_ID('tempdb..#SourceTemp') IS NOT NULL&#xA;    DROP TABLE #SourceTemp;&#xA;&#xA;SELECT &#xA;    s.ID,&#xA;    s.[Name],&#xA;    s.City,&#xA;    s.Email,&#xA;    s.Schedule_Date,&#xA;    -- Determine if there is already an active record for this ID and date.&#xA;    CASE &#xA;        WHEN t.Emp_Key IS NULL THEN 0  -- No active record exists; new load.&#xA;        ELSE 1                      -- Active record exists; will generate a new version.&#xA;    END AS RecordExists,&#xA;    t.Version_No  -- existing version number (if any)&#xA;INTO #SourceTemp&#xA;FROM dbo.Employee_Q3 s&#xA;LEFT JOIN dbo.Employee_Q3_Target t&#xA;    ON s.ID = t.ID &#xA;   AND s.Schedule_Date = t.Schedule_Date&#xA;   AND t.Active_Flag = 1;&#xA;&#xA;&#xA;/******************************************************&#xA; Step 2: Begin a transaction to update and insert data.&#xA;         - If an active record exists (RecordExists = 1) for that day,&#xA;           update it to set Active_Flag = 0.&#xA;         - Then insert a new record.&#xA;           * If there was an active record, Version_No = (existing Version_No + 1).&#xA;           * Otherwise, Version_No = 1.&#xA;*******************************************************/&#xA;BEGIN TRAN;&#xA;&#xA;-- Update active rows: Close the active records for the specific Schedule_Date.&#xA;UPDATE tgt&#xA;SET tgt.Active_Flag = 0&#xA;FROM dbo.Employee_Q3_Target tgt&#xA;INNER JOIN #SourceTemp st&#xA;    ON tgt.ID = st.ID&#xA;   AND tgt.Schedule_Date = st.Schedule_Date&#xA;WHERE st.RecordExists = 1&#xA;  AND tgt.Active_Flag = 1;&#xA;&#xA;-- Insert new records based on the source staging data.&#xA;INSERT INTO dbo.Employee_Q3_Target&#xA;    ([ID], [Name], City, Email, Schedule_Date, Insert_Date, Active_Flag, Version_No)&#xA;SELECT&#xA;    st.ID,&#xA;    st.[Name],&#xA;    st.City,&#xA;    st.Email,&#xA;    st.Schedule_Date,&#xA;    GETDATE(),  -- records current run time&#xA;    1,          -- set as active&#xA;    CASE &#xA;        WHEN st.RecordExists = 1 THEN st.Version_No + 1  -- increment version if record existed&#xA;        ELSE 1                                           -- new load: version 1&#xA;    END&#xA;FROM #SourceTemp st;&#xA;&#xA;COMMIT TRAN;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
